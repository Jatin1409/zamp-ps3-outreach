# Copy to .env for local development. Never commit .env.

# --- providers (required for live runs) ---
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Models (swap without code changes). LLM_MODEL drafts/verifies; LLM_MODEL_FAST classifies/scores.
LLM_MODEL=claude-opus-5-5
LLM_MODEL_FAST=claude-opus-5-5
LLM_EFFORT_FAST=low
LLM_EFFORT_DRAFT=medium

# --- storage ---
# Local default is SQLite (no setup). Production uses Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///local.db

# --- abuse protection on the public link ---
ACCESS_CODE=change-me
RUNS_PER_HOUR_PER_CLIENT=15
RUNS_PER_DAY_GLOBAL=150
MAX_CONCURRENT_RUNS=3

# Optional: run the job worker in a separate process (python -m app.worker) instead of in the web process
WORKER_ENABLED=true
