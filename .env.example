# Copy to .env for local development. Never commit .env.

# --- providers (required for live runs) ---
# LLM provider: gemini (default, free tier) | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=...            # https://aistudio.google.com -> Get API key
GEMINI_MODEL=gemini-3.6-flash           # drafts / verifies
GEMINI_MODEL_FAST=gemini-3.5-flash-lite # classifies / scores
LLM_MIN_INTERVAL_S=1.0                  # spacing between calls for free-tier per-minute quotas
# Free tier quotas are per model per day (gemini-3.6-flash: 20/day). Each tier falls back down its chain:
GEMINI_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_FAST_FALLBACKS=gemini-3.1-flash-lite
TAVILY_API_KEY=tvly-...
SEARCH_COST_PER_CALL_USD=0              # 0 on Tavily free tier; 0.008 on pay-as-you-go

# Thinking level per tier (Gemini thinking_level / Anthropic effort)
LLM_EFFORT_FAST=low
LLM_EFFORT_DRAFT=medium

# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MODEL_FAST=claude-opus-5-5

# --- storage ---
# Local default is SQLite (no setup). Production uses Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///local.db

# --- abuse protection on the public link ---
ACCESS_CODE=change-me
RUNS_PER_HOUR_PER_CLIENT=15
RUNS_PER_DAY_GLOBAL=150
MAX_CONCURRENT_RUNS=3

# Optional: run the job worker in a separate process (python -m app.worker) instead of in the web process
WORKER_ENABLED=true
